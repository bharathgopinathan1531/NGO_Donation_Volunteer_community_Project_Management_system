# Application
APP_NAME="NGO Donation, Volunteer & Community Project Management System"
ENVIRONMENT=development          # development | production | test
DEBUG=false

# Database (PostgreSQL shown; MySQL: mysql+pymysql://user:pass@host:3306/db)
DATABASE_URL=postgresql+psycopg2://ngo_user:ngo_password@localhost:5432/ngo_db

# Security - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

# In development the reset token is returned by /auth/forgot-password. Keep false in production.
EXPOSE_RESET_TOKEN=false

# Bootstrap super admin (used by scripts/create_super_admin.py)
SUPER_ADMIN_EMAIL=admin@ngo.org
SUPER_ADMIN_PASSWORD=ChangeMe@123
SUPER_ADMIN_NAME="Super Admin"

# Business settings
DEADLINE_ALERT_DAYS=7
CORS_ORIGINS=["http://localhost:3000"]
