        "type": "text/javascript",
        "exec": [
          "// keep dates valid whenever the collection is run",
          "const iso = (d) => d.toISOString().slice(0, 10);",
          "const now = new Date();",
          "pm.collectionVariables.set('today', iso(now));",
          "pm.collectionVariables.set('end_date', iso(new Date(now.getTime() + 60 * 86400000)));"
        ]
      }
